{
  "name": "wordmine-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "build": "node scripts/build.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "cloudflare:login": "wrangler login",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:check": "npm run build && node scripts/verify-cloudflare.mjs && wrangler deploy --dry-run --outdir dist/cloudflare-check",
    "cloudflare:db:local": "wrangler d1 migrations apply DB --local",
    "cloudflare:db:remote": "wrangler d1 migrations apply DB --remote",
    "cloudflare:deploy": "wrangler deploy",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "test": "node --test",
    "cloudflare:db:create": "wrangler d1 create word-mine-rooms --binding DB --update-config"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}
